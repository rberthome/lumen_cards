{
  "name": "lumen_cards",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@lumen_cards/types": "file:../../packages/types",
    "@tanstack/react-query": "^5.101.1",
    "expo": "~56.0.12",
    "expo-localization": "^56.0.6",
    "expo-status-bar": "~56.0.4",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-native": "0.85.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "cd ../.. && husky"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@lumen_cards/types$": "<rootDir>/../../packages/types/index.ts"
    }
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,json,md}": "prettier --write"
  }
}
