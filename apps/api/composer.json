{
    "name": "lumencards/api",
    "type": "project",
    "description": "LumenCards API — flashcards philosophiques & maçonniques",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.12.0",
        "laravel/framework": "^13.16.1",
        "laravel/sanctum": "^4.3.2",
        "laravel/tinker": "^3.0.2",
        "spatie/laravel-typescript-transformer": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/pint": "^1.29.3",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "phpunit/phpunit": "^13.2.1",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
